+function playSeason(g){
+ for(let k=0;k<3;k++){
+  g=startTraining(g,'study',[],random);
+  assert.equal(g.scene,'result');
+  g=continueFromResult(g,random);
+  if(k<2)assert.equal(g.scene,'main');
+ }
+ assert.equal(g.scene,'tournament');return g;
